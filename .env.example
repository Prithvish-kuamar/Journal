# PostgreSQL connection pool URL used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/evidence_ledger?schema=public&sslmode=require"
# Direct, non-pooled PostgreSQL URL used by Prisma migrations (Supabase session mode).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/evidence_ledger?schema=public&sslmode=require"
# Supabase/Auth placeholders reserved for the Personal Production V1 auth task.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key-never-expose-in-browser"
SUPABASE_SECRET_KEY="replace-with-supabase-secret-key-never-expose-in-browser"
SUPABASE_STORAGE_BUCKET="evidence-private"
OWNER_EMAIL="owner@example.com"
APP_URL="http://localhost:3000"
NODE_ENV="development"
UPLOAD_DIR="uploads"
